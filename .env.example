# ─── Discord Bot ────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Set to "true" to deploy commands globally instead of guild-only
GLOBAL_DEPLOY=true

# ─── Bot Settings ────────────────────────────────────────────────
# Your Discord user ID – gives you owner-level access
OWNER_ID=your_discord_user_id_here

# Bot status message (shown as "Watching ...")
BOT_STATUS=Hacking minecraft accounts

# Channel IDs for /free and /premium commands
GEN_CHANNEL_ID=your_free_channel_id
PREMIUM_CHANNEL_ID=your_premium_channel_id

# Cooldowns in seconds
GEN_COOLDOWN=1800
PREMIUM_COOLDOWN=900

# Max number of free/premium gens per user (0 = unlimited)
FREE_LIMIT=5
PREMIUM_LIMIT=5

# Embed banner image URL
BANNER_URL=https://media.discordapp.net/attachments/960440723369517106/996423763522506782/rainbow-border.gif

# Footer text for embeds
EMBED_FOOTER=Made By Nokiatis

# ─── Dashboard ───────────────────────────────────────────────────
PORT=3000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
SESSION_SECRET=change_this_to_a_long_random_string

# ─── Linkvertise (optional) ──────────────────────────────────────
# Leave blank to skip Linkvertise verification for /free
LINKVERTISE_PUBLISHER_ID=
LINKVERTISE_ANTI_BYPASS_TOKEN=
